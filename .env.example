# Optional ClickHouse overrides (defaults are in docker-compose.yml).
# CLICKHOUSE_DB=logs
# CLICKHOUSE_USER=logregartor
# CLICKHOUSE_PASSWORD=localdev

# The UI reads ClickHouse only through its parameterized server route.
# Local npm development defaults to http://127.0.0.1:8123.
# LOGS_CLICKHOUSE_URL=http://127.0.0.1:8123
# LOGS_CLICKHOUSE_DATABASE=logs
# LOGS_CLICKHOUSE_USER=logregartor
# LOGS_CLICKHOUSE_PASSWORD=localdev

# Generate two different values with: openssl rand -hex 32
CLICKHOUSE_MCP_PASSWORD=
CLICKHOUSE_MCP_AUTH_TOKEN=
# CLICKHOUSE_MCP_PORT=8000

UI_PORT=3000
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.4
MCP_SERVER_URL=http://mcp-clickhouse:8000/mcp
ANALYTICS_API_URL=http://analytics:8080
# ANALYTICS_PORT=8080

# Optional image and port overrides.
# CLICKHOUSE_VERSION=26.3.29.7
# CLICKHOUSE_HTTP_PORT=8123
# CLICKHOUSE_NATIVE_PORT=9000
